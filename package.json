{
  "name": "karting-nextjs",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:docker": "docker compose -f docker-compose.dev.yaml up --build --watch",
    "prebuild": "npm run lint && npm run format",
    "build": "next build && next-image-export-optimizer",
    "start": "serve ./out",
    "start:ssr": "next start",
    "start:docker": "docker compose up -d --build",
    "lint": "next build && eslint .",
    "format": "prettier --write src/app/"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "postcss": "^8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serve": "^14.2.6",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "next-image-export-optimizer": "^1.21.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6"
  }
}
